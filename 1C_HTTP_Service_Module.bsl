// =========================================================================
// 1С HTTP-СЕРВИС: WebAPI
// Корневой URL: webapi
// =========================================================================

// -------------------------------------------------------------------------
// ШАБЛОН: /data [GET]
// Функция-обработчик запроса получения данных
// -------------------------------------------------------------------------
Функция ПолучитьДанные(Запрос)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// 1. Параметрларни ўқиш
	Дата1Текст = Запрос.ПараметрыЗапроса.Получить("date1");
	Дата2Текст = Запрос.ПараметрыЗапроса.Получить("date2");
	
	Сана1 = ?(ЗначениеЗаполнено(Дата1Текст), НачалоДня(Дата(СтрЗаменить(Дата1Текст, "-", ""))), НачалоМесяца(ТекущаяДата()));
	Сана2 = ?(ЗначениеЗаполнено(Дата2Текст), КонецДня(Дата(СтрЗаменить(Дата2Текст, "-", ""))), КонецДня(ТекущаяДата()));
	
	ДанныеСтруктура = Новый Структура;
	
	// --- 1. КАССА КИРИМЛАРИ (КассаКиримлари) ---
	ЗапросКирим = Новый Запрос;
	ЗапросКирим.Текст = 
		"ВЫБРАТЬ
		|	КассаКиримлари.Ссылка КАК Ссылка,
		|	КассаКиримлари.Дата КАК Дата,
		|	КассаКиримлари.Номер КАК Номер,
		|	КассаКиримлари.Контрогенты.Наименование КАК КонтрагентНаименование,
		|	КассаКиримлари.Сумма КАК Сумма,
		|	КассаКиримлари.Изох КАК Изох
		|ИЗ
		|	Документ.КассаКиримлари КАК КассаКиримлари
		|ГДЕ
		|	КассаКиримлари.Проведен = ИСТИНА
		|	И КассаКиримлари.Дата МЕЖДУ &Дата1 И &Дата2
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
	ЗапросКирим.УстановитьПараметр("Дата1", Сана1);
	ЗапросКирим.УстановитьПараметр("Дата2", Сана2);
	
	МассивКирим = Новый Массив;
	ВыборкаКирим = ЗапросКирим.Выполнить().Выбрать();
	Пока ВыборкаКирим.Следующий() Цикл
		Стр = Новый Структура;
		Стр.Вставить("date", Формат(ВыборкаКирим.Дата, "ДФ='dd.MM.yyyy HH:mm'"));
		Стр.Вставить("number", СокрЛП(ВыборкаКирим.Номер));
		Стр.Вставить("counterparty", ВыборкаКирим.КонтрагентНаименование);
		Стр.Вставить("amount", ВыборкаКирим.Сумма);
		Стр.Вставить("comment", ВыборкаКирим.Изох);
		МассивКирим.Добавить(Стр);
	КонецЦикла;
	ДанныеСтруктура.Вставить("cashReceipts", МассивКирим);
	
	// --- 2. КАССА ЧИКИМЛАРИ (КассаЧикимлари) ---
	ЗапросЧиким = Новый Запрос;
	ЗапросЧиким.Текст = 
		"ВЫБРАТЬ
		|	КассаЧикимлари.Ссылка КАК Ссылка,
		|	КассаЧикимлари.Дата КАК Дата,
		|	КассаЧикимлари.Номер КАК Номер,
		|	КассаЧикимлари.Контрогенты.Наименование КАК КонтрагентНаименование,
		|	КассаЧикимлари.Сумма КАК Сумма,
		|	КассаЧикимлари.Изох КАК Изох
		|ИЗ
		|	Документ.КассаЧикимлари КАК КассаЧикимлари
		|ГДЕ
		|	КассаЧикимлари.Проведен = ИСТИНА
		|	И КассаЧикимлари.Дата МЕЖДУ &Дата1 И &Дата2
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
	ЗапросЧиким.УстановитьПараметр("Дата1", Сана1);
	ЗапросЧиким.УстановитьПараметр("Дата2", Сана2);
	
	МассивЧиким = Новый Массив;
	ВыборкаЧиким = ЗапросЧиким.Выполнить().Выбрать();
	Пока ВыборкаЧиким.Следующий() Цикл
		Стр = Новый Структура;
		Стр.Вставить("date", Формат(ВыборкаЧиким.Дата, "ДФ='dd.MM.yyyy HH:mm'"));
		Стр.Вставить("number", СокрЛП(ВыборкаЧиким.Номер));
		Стр.Вставить("counterparty", ВыборкаЧиким.КонтрагентНаименование);
		Стр.Вставить("amount", ВыборкаЧиким.Сумма);
		Стр.Вставить("comment", ВыборкаЧиким.Изох);
		МассивЧиким.Добавить(Стр);
	КонецЦикла;
	ДанныеСтруктура.Вставить("cashDisbursements", МассивЧиким);
	
	// --- 3. ТОВАРЛАР РЎЙХАТИ (Товарлар ва Сотув айланмаси) ---
	ЗапросТовары = Новый Запрос;
	ЗапросТовары.Текст = 
		"ВЫБРАТЬ
		|	Товары.Наименование КАК ТоварНаименование,
		|	ЕСТЬNULL(СУММА(ТоварларОмбориОбороты.КолКгОборот), 0) КАК СотилганКг,
		|	ЕСТЬNULL(СУММА(ТоварларОмбориОбороты.КопОборот), 0) КАК СотилганКоп,
		|	ЕСТЬNULL(СУММА(ТоварларОмбориОбороты.СуммаОборот), 0) КАК Сумма
		|ИЗ
		|	Справочник.Товарлар КАК Товары
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварларОмбори.Обороты(&Дата1, &Дата2, , ) КАК ТоварларОмбориОбороты
		|		ПО Товары.Ссылка = ТоварларОмбориОбороты.Товарлар
		|СГРУППИРОВАТЬ ПО
		|	Товары.Наименование
		|УПОРЯДОЧИТЬ ПО
		|	ТоварНаименование";
	ЗапросТовары.УстановитьПараметр("Дата1", Сана1);
	ЗапросТовары.УстановитьПараметр("Дата2", Сана2);
	
	МассивТоваров = Новый Массив;
	ВыборкаТоваров = ЗапросТовары.Выполнить().Выбрать();
	Пока ВыборкаТоваров.Следующий() Цикл
		Стр = Новый Структура;
		Стр.Вставить("name", ВыборкаТоваров.ТоварНаименование);
		Стр.Вставить("weight", ВыборкаТоваров.СотилганКг);
		Стр.Вставить("rolls", ВыборкаТоваров.СотилганКоп);
		Стр.Вставить("sum", ВыборкаТоваров.Сумма);
		МассивТоваров.Добавить(Стр);
	КонецЦикла;
	ДанныеСтруктура.Вставить("goods", МассивТоваров);
	
	// --- 4. ХАРИДОРЛАР ҚАРЗИ РЎЙХАТИ (Харидорлар қарздорлиги) ---
	ЗапросХаридор = Новый Запрос;
	ЗапросХаридор.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Наименование КАК КлиентНаименование,
		|	Контрагенты.Телефон КАК Телефон,
		|	-ЕСТЬNULL(УзароХисобКитобларОстатки.КарзСуммасиОстаток, 0) КАК КарзСуммаси
		|ИЗ
		|	Справочник.Контрогенты КАК Контрагенты
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.УзароХисобКитоблар.Остатки(, ) КАК УзароХисобКитобларОстатки
		|		ПО Контрагенты.Ссылка = УзароХисобКитобларОстатки.Контрогент
		|ГДЕ
		|	УзароХисобКитобларОстатки.КарзСуммасиОстаток < 0
		|УПОРЯДОЧИТЬ ПО
		|	КлиентНаименование";
	
	МассивХаридор = Новый Массив;
	ВыборкаХаридор = ЗапросХаридор.Выполнить().Выбрать();
	Пока ВыборкаХаридор.Следующий() Цикл
		Стр = Новый Структура;
		Стр.Вставить("name", ВыборкаХаридор.КлиентНаименование);
		Стр.Вставить("phone", ВыборкаХаридор.Телефон);
		Стр.Вставить("debt", ВыборкаХаридор.КарзСуммаси);
		МассивХаридор.Добавить(Стр);
	КонецЦикла;
	ДанныеStruct = МассивХаридор;
	ДанныеСтруктура.Вставить("customers", МассивХаридор);
	
	// --- 5. ТАЪМИНОТЧИЛАР ҲАҚҚИ РЎЙХАТИ (Таъминотчилар қарздорлиги) ---
	ЗапросТаминотчи = Новый Запрос;
	ЗапросТаминотчи.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Наименование КАК КлиентНаименование,
		|	Контрагенты.Телефон КАК Телефон,
		|	ЕСТЬNULL(УзароХисобКитобларОстатки.КарзСуммасиОстаток, 0) КАК КарзСуммаси
		|ИЗ
		|	Справочник.Контрогенты КАК Контрагенты
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.УзароХисобКитоблар.Остатки(, ) КАК УзароХисобКитобларОстатки
		|		ПО Контрагенты.Ссылка = УзароХисобКитобларОстатки.Контрогент
		|ГДЕ
		|	УзароХисобКитобларОстатки.КарзСуммасиОстаток > 0
		|УПОРЯДОЧИТЬ ПО
		|	КлиентНаименование";
	
	МассивТаминотчи = Новый Массив;
	ВыборкаТаминотчи = ЗапросТаминотчи.Выполнить().Выбрать();
	Пока ВыборкаТаминотчи.Следующий() Цикл
		Стр = Новый Структура;
		Стр.Вставить("name", ВыборкаТаминотчи.КлиентНаименование);
		Стр.Вставить("phone", ВыборкаТаминотчи.Телефон);
		Стр.Вставить("claim", ВыборкаТаминотчи.КарзСуммаси);
		МассивТаминотчи.Добавить(Стр);
	КонецЦикла;
	ДанныеСтруктура.Вставить("suppliers", МассивТаминотчи);
	
	// --- 6. КОНТРАГЕНТЛАР РЎЙХАТИ (Dropdown рўйхати учун) ---
	ЗапросК = Новый Запрос;
	ЗапросК.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Наименование КАК Наименование,
		|	ВЫБОР
		|		КОГДА Контрагенты.Поставщик = ИСТИНА ТОГДА ""supplier""
		|		ИНАЧЕ ""customer""
		|	КОНЕЦ КАК Тип
		|ИЗ
		|	Справочник.Контрогенты КАК Контрагенты
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	
	МассивК = Новый Массив;
	ВыборкаК = ЗапросК.Выполнить().Выбрать();
	Пока ВыборкаК.Следующий() Цикл
		Стр = Новый Структура;
		Стр.Вставить("id", Строка(ВыборкаК.Ссылка.УникальныйИдентификатор()));
		Стр.Вставить("name", ВыборкаК.Наименование);
		Стр.Вставить("type", ВыборкаК.Тип);
		МассивК.Добавить(Стр);
	КонецЦикла;
	ДанныеСтруктура.Вставить("counterparties", МассивК);
	
	// 2. Жавобни JSON кўринишида қайтариш
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеСтруктура);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
	
	Возврат Ответ;
	
КонецФункции

// -------------------------------------------------------------------------
// ШАБЛОН: /save_payment [POST]
// Функция-обработчик запроса сохранения нового платежа
// -------------------------------------------------------------------------
Функция СохранитьПлатеж(Запрос)
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтрокаТела = Запрос.ПолучитьТелоИзСтроки(КодировкаТекста.UTF8);
	
	// JSON ни ўқиш
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаТела);
	ДанныеТранзакции = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	ТипПлатежа = ДанныеТранзакции.type; // "receipt" ёки "disbursement"
	КонтрагентID = ДанныеТранзакции.counterpartyId;
	СуммаТранзакции = ДанныеТранзакции.amount;
	Изох = ?(ДанныеТранзакции.Свойство("comment"), ДанныеТранзакции.comment, "");
	
	// Ссылкани топиш
	СсылкаКонтрагент = Справочники.Контрогенты.ПолучитьСсылку(Новый УникальныйИдентификатор(КонтрагентID));
	Если СсылкаКонтрагент.Пустая() Тогда
		// Агар топилмаса наименование бўйича қидириб кўриш
		КонтрагентName = ДанныеТранзакции.counterpartyName;
		СсылкаКонтрагент = Справочники.Контрогенты.НайтиПоНаименованию(КонтрагентName);
	КонецЕсли;
	
	Если СсылкаКонтрагент.Пустая() Или НЕ ЗначениеЗаполнено(СсылкаКонтрагент) Тогда
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки("{""status"":""error"", ""message"":""Контрагент топилмади!""}", КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецЕсли;
	
	Если ТипПлатежа = "receipt" Тогда
		// Кирим ҳужжатини яратиш (КассаКиримлари)
		ДокОбъект = Документы.КассаКиримлари.СоздатьДокумент();
	ИначеЕсли ТипПлатежа = "disbursement" Тогда
		// Чиқим ҳужжатини яратиш (КассаЧикимлари)
		ДокОбъект = Документы.КассаЧикимлари.СоздатьДокумент();
	Иначе
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки("{""status"":""error"", ""message"":""Нотўғри амалиёт тури!""}", КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецЕсли;
	
	// Реквизитларни тўлдириш
	ДокОбъект.Дата = ТекущаяДата();
	ДокОбъект.Контрогенты = СсылкаКонтрагент;
	ДокОбъект.Сумма = СуммаТранзакции;
	ДокОбъект.Изох = Изох;
	
	Попытка
		ДокОбъект.Мобил = Истина;
	Исключение
	КонецПопытки;
	
	Попытка
		// Ёзиш ва ўтказиш (проведение)
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.УстановитьТелоИзСтроки("{""status"":""success"", ""message"":""Муваффақиятли сақланди!""}", КодировкаТекста.UTF8);
		Возврат Ответ;
	Исключение
		ИнформацияОбОшибке = ОписаниеОшибки();
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки("{""status"":""error"", ""message"":""" + Строка(ИнформацияОбОшибке) + """}", КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
	
КонецФункции
